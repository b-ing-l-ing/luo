# 复制为 .env 后填写
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 如果这个模型名在你的账号下不可用，改成控制台里的模型 ID
DEEPSEEK_MODEL=deepseek-flash

HISTORY_LIMIT=20
# 有上次摘要/未完成的事时，启动先开口
STARTUP_GREETING=true
# 在终端标出命中的 AI 味说法（调试用）
STYLE_DEBUG=false

# QQ（NapCat / OneBot 11，私聊）
QQ_WS_URL=ws://127.0.0.1:3001
QQ_ACCESS_TOKEN=
# 允许私聊的 QQ 号，逗号分隔；留空会拒绝启动
QQ_ALLOWED_USERS=
# 小号自己的 QQ 号，可选，用来过滤自己发的消息
QQ_SELF_ID=
# 分条回复：最多几条、条间隔多少秒
QQ_BURST_MAX=3
QQ_BURST_DELAY=0.8

# Minecraft 边车
MC_WS_URL=ws://127.0.0.1:3002
MC_BOT_NAME=LuoBot
# 允许在游戏里对话的玩家名，逗号分隔；留空允许所有
MC_ALLOWED_PLAYERS=

# 联网搜索（按需）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_MODEL=deepseek-v4-flash
WEB_SEARCH_MAX_RESULTS=5
# 联网搜到的梗图，发送后自动存库；每小时最多几次
AUTO_SAVE_WEB_MEMES=true
WEB_MEME_MAX_PER_HOUR=3

# 跨通道身份映射：例 qq:123456=local 让 QQ 主号与终端共用 local
SESSION_ALIASES=

# 主动消息（QQ 私聊空闲且有未完成的事时）
PROACTIVE_ENABLED=true
PROACTIVE_IDLE_MINUTES=120
PROACTIVE_COOLDOWN_MINUTES=720
PROACTIVE_CHECK_SECONDS=60
